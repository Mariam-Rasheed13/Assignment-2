<section class="container">

    <!--Contact Me Page Heading-->
    <h1 class="text-center mb-4">✉️ Contact Me ✉️</h1>

    <!--Contact Form-->
    <div class="contact-section">

        <form action="/contact" method="POST">

            <!--First Name Field-->
            <div class="mb-4">
                <label for="firstName" class="form-label">👤 First Name</label>
                <input type="text" class="form-control" id="firstName" name="firstName"
                    placeholder="Enter your first name" required>
            </div>

            <!--Last Name Field-->
            <div class="mb-4">
                <label for="lastName" class="form-label">👤 Last Name</label>
                <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Enter your last name"
                    required>
            </div>

            <!--Email Field-->
            <div class="mb-4">
                <label for="email" class="form-label">📧 Email</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email address"
                    required>
            </div>

            <!--Phone Number Field-->
            <div class="mb-4">
                <label for="phone" class="form-label">📞 Phone Number (xxx-xxx-xxxx)</label>
                <input type="tel" class="form-control" id="phone" name="phone" placeholder="Enter your phone number"
                    pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" required>
            </div>

            <!--Comments Field-->
            <div class="mb-4">
                <label for="comments" class="form-label">📝 Comments</label>
                <textarea class="form-control" id="comments" name="comments" rows="4"
                    placeholder="Enter your comments"></textarea>
            </div>

            <!--Verification Checkbox-->
            <div class="verification-box mb-3">
                <input type="checkbox" id="verification" name="verification" required>

                <label for="verification">I'm not a robot 🤖</label>
            </div>

            <!--Form Buttons-->
            <div class="text-center">
                <button type="reset" class="btn reset-button">↻ Reset</button>
                <button type="submit" class="btn submit-button">✓ Submit</button>
            </div>
        </form>

    </div>

    <% if (typeof submitted !=='undefined' && submitted) { %>
        <p class="text-center mt-3">
            Thank you! Your form has been submitted successfully.
        </p>
    <% } %>

</section>